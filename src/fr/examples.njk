  },
  {
    src: "https://player.vimeo.com/video/1129203402",
    videoTitle: "Accessibilité avec LViS : la danse du squelette",
    title: "La danse du squelette",
    desc: "Exemple narratif pour tester la description des actions, de la musique et des scènes."
  },
  {
    src: "https://player.vimeo.com/video/1228788912",
    videoTitle: "Une chorale en entreprise",
    title: "Une chorale en entreprise",
    desc: "Exemple d'événement d'entreprise avec sous-titres et audiodescription."
  },
  {
    src: "https://player.vimeo.com/video/1228811136",
    videoTitle: "Clip de présentation des Jeux Olympiques de Paris 2024",
    title: "Clip de présentation des Jeux Olympiques de Paris 2024",
    desc: "Exemple de clip promotionnel avec sous-titres et audiodescription."
  },
  {
    src: "https://player.vimeo.com/video/1228804794",
    videoTitle: "Un escape game pour lutter contre le harcèlement",
    title: "Un escape game pour lutter contre le harcèlement",
    desc: "Exemple de contenu de sensibilisation avec sous-titres et audiodescription."
  },
  {
    src: "https://player.vimeo.com/video/1228844394",
    videoTitle: "La discrimination en deux minutes – Amnesty International, section suisse (2019)",
    title: "La discrimination en deux minutes – Amnesty International, section suisse (2019)",
    desc: "Exemple de campagne de sensibilisation avec sous-titres et audiodescription."
  }
] %}

{{ hero.catalogHero(
  t,
  "EXEMPLES",
  "Exemples de vidéos accessibles",
  "Découvrez comment le contenu se vit avec sous-titres, audiodescription, transcription, chapitres, résumés en lecture facile et téléchargements.",
  ["AD", "CC", "TR", "SL", "ER"],
  "Audiodescription, sous-titres, transcription, langue des signes, résumés en lecture facile et formats prêts à publier.",
  "/fr/services/",
  "Voir les services"
) }}

<section id="examples-grid" aria-labelledby="examples-grid-heading">
  <div class="wrapper">
    <h2 id="examples-grid-heading" class="sr-only">Exemples de vidéos accessibles</h2>
    <div class="examples-grid">
      {%- for example in examples %}
      <article class="example-card">
        <div class="example-card__thumb">
          <iframe src="{{ example.src }}" title="{{ example.videoTitle }}" loading="lazy" allow="fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div class="example-card__body">
          <h3 class="example-card__title">{{ example.title }}</h3>
          <p class="example-card__desc">{{ example.desc }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>

    <div class="examples-social">
      <a href="https://www.youtube.com/@lvisvideo" target="_blank" rel="noopener" aria-label="Chaîne YouTube">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
      </a>
      <a href="https://vimeo.com/lvisvideo" target="_blank" rel="noopener" aria-label="Chaîne Vimeo">
        <i class="fa-brands fa-vimeo-v" aria-hidden="true"></i>
      </a>
    </div>

    <aside class="examples-note" role="note">
      <p><strong>Remarque :</strong> activez les sous-titres et l'audiodescription. Dans la version finale, vous pouvez ajouter des chapitres, une transcription complète, un résumé en lecture facile et des téléchargements.</p>
    </aside>
  </div>
</section>

{{ cta.demoSection(
  "Vos contenus audiovisuels, à la portée de tous. Sans barrières.",
  "Quand commençons-nous ?",
  "Expliquez-nous quelles vidéos vous devez adapter et nous vous aiderons à évaluer le projet, les formats et les délais.",
  "Demandez un rendez-vous",
  "https://calendly.com/lvis-meetings/30min",
  "Demander une consultation. Ouvre le calendrier de réservation dans un nouvel onglet."
) }}
