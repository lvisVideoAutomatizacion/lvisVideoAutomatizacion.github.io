<section id="partners" class="partners-tables wrapper clearfix">
  <div class="grid-1">
    <h2>Un modèle flexible pour les partenaires technologiques et commerciaux</h2>
    <h3>Nous apportons technologie, méthodologie et capacité de production afin que nos partenaires puissent proposer l'accessibilité audiovisuelle à leurs clients sans avoir à construire tout le processus à partir de zéro.</h3>
  </div>

  <div class="grid-3 partners">
    {%- for partner in partners %}
    {{ partnerBox(partner) }}
    {%- endfor %}

    <div class="box col box--contact">
      <div class="box__head">
        <h3 class="box__title">Vous souhaitez rejoindre nos partenaires ?</h3>
      </div>
      <a class="button-cta" href="https://eu.bigin.online/org20092830437/forms/contacta-con-nosotros">Contactez-nous</a>
    </div>
  </div>
</section>

