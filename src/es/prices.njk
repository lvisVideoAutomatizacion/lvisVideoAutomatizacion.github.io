      {{ pricingClosedCard({
        name: "Taller práctico",
        price: "1.600 € · 8 horas",
        desc: [
          "Hasta 8 participantes.",
          "Adecuado para formar técnicos, equipos multimedia, profesores y personal audiovisual",
          "Temario: mecanismos, herramientas, plataformas, mejores prácticas, proyecto real"
