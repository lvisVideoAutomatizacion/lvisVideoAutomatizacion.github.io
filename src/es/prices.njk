---
layout: base.njk
title: Precios
---
{% import "macros/hero.njk" as hero %}
{% import "macros/cta.njk" as cta %}

{% macro pricingDurCard(c) %}
<div class="pricing-dur-card{{ ' pricing-dur-card--highlight' if c.highlight }}">
  <p class="pricing-dur-name">{{ c.name }}</p>
  <p class="pricing-dur-range{{ ' pricing-dur-range--accent' if c.rangeAccent }}">{{ c.range }}</p>
  <p class="pricing-dur-price{{ ' pricing-dur-price--lg' if c.priceLg }}">{{ c.price | safe }}</p>
  {% if c.extra %}<p class="pricing-dur-extra">{{ c.extra }}</p>{% endif %}
  <p class="pricing-dur-desc">{{ c.desc }}</p>
</div>
{% endmacro %}

{% macro pricingClosedCard(c) %}
<div class="pricing-closed-card">
  <p class="pricing-closed-name">{{ c.name }}</p>
  {% if c.price %}<p class="pricing-closed-price{{ ' pricing-closed-price--link' if c.priceLink }}">{{ c.price }}</p>{% endif %}
  {% for d in c.desc %}
  <p class="pricing-closed-desc">{{ d }}</p>
  {% endfor %}
  {% if c.cta %}<a href="{{ c.cta.href }}" target="_blank" rel="noopener" class="pricing-closed-cta">{{ c.cta.label }}</a>{% endif %}
</div>
{% endmacro %}

{{ hero.catalogHero(
  t,
  "PRECIOS",
  "Tarifas claras para trabajos puntuales. Soluciones a medida para grandes proyectos.",
  "Mostramos precios de servicios estandarizados y mantenemos los proyectos complejos como propuestas personalizadas.",
  ["AD", "CC", "TR", "LSE", "LF"],
  "Audiodescripción, subtítulos cerrados, transcripción, lengua de signos, lectura fácil y formatos listos para publicar.",
  "/es/services/",
  "Ver servicios"
) }}

<section id="pricing-spot" class="wrapper">
  <div class="pricing-block">
    <span class="pricing-block-label">TRABAJOS PUNTUALES</span>
    <h2 class="pricing-block-title">Producción accesible por duración</h2>
    <div class="pricing-cards-row">
      {{ pricingDurCard({
        name: "Microvideos",
        range: "< 3 minutos",
        price: "40 €<small>/minuto</small>",
        extra: "Pedido mínimo 3 minutos.",
        desc: "Anuncios, redes sociales, mensajes institucionales, píldoras formativas y comunicaciones breves."
      }) }}
      {{ pricingDurCard({
        name: "Vídeos cortos",
        range: "3 a 5 minutos",
        price: "35 €<small>/minuto</small>",
        desc: "Tutoriales rápidos, presentaciones, demostraciones de producto y contenidos educativos de corta duración.",
        highlight: true
      }) }}
      {{ pricingDurCard({
        name: "Vídeos medios",
        range: "5 a 20 minutos",
        price: "30 €<small>/minuto</small>",
        desc: "Reportajes, entrevistas, webinars, clases, formaciones y presentaciones corporativas."
      }) }}
      {{ pricingDurCard({
        name: "Vídeos largos",
        range: "21 a 60 minutos",
        price: "Desde 600 €",
        priceLg: true,
        extra: "+ 10 €/min adicional",
        desc: "Conferencias, cursos completos, eventos, mesas redondas, documentales y sesiones técnicas."
      }) }}
      {{ pricingDurCard({
        name: "Vídeos extensos",
        range: "Más de 60 minutos",
        rangeAccent: true,
        price: "Desde 1.000 €",
        priceLg: true,
        extra: "+ 8 €/min adicional",
        desc: "Congresos, jornadas, plenos, cursos modulares, grabaciones de eventos completos, y series formativas."
      }) }}
    </div>
    <div class="pricing-options-bar">
      <p><strong>Opciones:</strong> entrega urgente en 1 día laborable (+50%), lengua de signos desde 25 €/min y traducción a otro idioma (+30%).</p>
    </div>
  </div>
</section>

