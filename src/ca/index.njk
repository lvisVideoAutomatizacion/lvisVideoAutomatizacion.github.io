---
layout: base.njk
title: Inici
---
{% import "macros/cta.njk" as cta %}

{% macro heroStatCard(number, label) %}
<div class="hero-stat-card">
  <span class="hero-stat-number">{{ number }}</span>
  <span class="hero-stat-label">{{ label }}</span>
</div>
{% endmacro %}

{% macro whyCard(number, title, desc) %}
<article class="why-card">
  <span class="why-card-number">{{ number }}</span>
  <h3>{{ title }}</h3>
  <p>{{ desc }}</p>
</article>
{% endmacro %}

{% macro mainServicesCard(title, desc, href, label) %}
<article class="main-services-card">
  <h3>{{ title }}</h3>
  <p>{{ desc }}</p>
  <a href="{{ href }}" class="main-services-link">{{ label }} →</a>
</article>
{% endmacro %}

{% macro clientLogo(client) %}
<div class="clients-logo{{ ' clients-logo--square' if client.square }}">
  {%- if client.url %}
  <a href="{{ client.url }}" target="_blank" rel="noopener" aria-label="{{ client.alt }}">
    <img src="{{ client.logo }}" alt="" loading="lazy">
  </a>
  {%- else %}
  <img src="{{ client.logo }}" alt="{{ client.alt }}" loading="lazy">
  {%- endif %}
</div>
{% endmacro %}

{% set clients = [
