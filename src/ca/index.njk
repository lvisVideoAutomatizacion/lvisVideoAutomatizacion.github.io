  { logo: "/assets/images/clients/diputacio_barcelona_logo.png", alt: "logotip Diputació de Barcelona", url: "https://www.diba.cat/ca/inici", square: true },
  { logo: "/assets/images/clients/telefonica.png", alt: "logotip Telefónica", url: "https://www.telefonica.com/" },
