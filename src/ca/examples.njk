] %}

{{ hero.catalogHero(
  t,
  "EXEMPLES",
  "Exemples de vídeos accessibles",
  "Mostra com es consumeixen els continguts amb subtítols, audiodescripció, transcripció, capítols, lectura fàcil i descàrregues.",
  ["AD", "CC", "TR", "LSE", "LF"],
  "Audiodescripció, subtítols tancats, transcripció, llengua de signes, lectura fàcil i formats a punt per publicar.",
  "/ca/services/",
  "Veure serveis"
) }}

<section id="examples-grid" aria-labelledby="examples-grid-heading">
  <div class="wrapper">
    <h2 id="examples-grid-heading" class="sr-only">Exemples de vídeos accessibles</h2>
    <div class="examples-grid">
      {%- for example in examples %}
      <article class="example-card">
        <div class="example-card__thumb">
          <iframe src="{{ example.src }}" title="{{ example.videoTitle }}" loading="lazy" allow="fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <div class="example-card__body">
          <h3 class="example-card__title">{{ example.title }}</h3>
          <p class="example-card__desc">{{ example.desc }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>

    <div class="examples-social">
      <a href="https://www.youtube.com/@lvisvideo" target="_blank" rel="noopener" aria-label="Canal de YouTube">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
      </a>
      <a href="https://vimeo.com/lvisvideo" target="_blank" rel="noopener" aria-label="Canal de Vimeo">
        <i class="fa-brands fa-vimeo-v" aria-hidden="true"></i>
      </a>
    </div>

    <aside class="examples-note" role="note">
      <p><strong>Nota:</strong> activa els subtítols i l'audiodescripció. A la versió final es poden afegir capítols, transcripció completa, sumari en lectura fàcil i descàrregues.</p>
    </aside>
  </div>
</section>

{{ cta.demoSection(
  "Els teus continguts audiovisuals, per a tothom. Sense barreres.",
  "Quan comencem?",
  "Explica'ns quins vídeos necessites adaptar i t'ajudem a estimar l'esforç, els formats i els terminis.",
  "Demana una consulta",
  "https://calendly.com/lvis-meetings/30min",
  "Sol·licitar una consulta. S'obre el calendari de reserves en una pestanya nova."
) }}
